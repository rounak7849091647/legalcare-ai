# Build-time config for production (Cloudflare).
#
# These are PUBLIC client identifiers: they are compiled into the browser
# bundle and visible in page source, so committing them leaks nothing. Server
# secrets (API keys, passwords, AWS credentials) live in server/.env and are
# gitignored — never put those here, VITE_* values are shipped to every visitor.
#
# Without these the build produces an app whose Cognito pool id is undefined,
# which throws 'Invalid UserPoolId format' before React mounts (blank page).

VITE_API_URL=https://api.legalcareai.com
VITE_COGNITO_USER_POOL_ID=us-east-1_oPnmY3d5J
VITE_COGNITO_CLIENT_ID=65g47pnbst6h5omadmfa5k6lsk
VITE_GOOGLE_CLIENT_ID=105220794813-3uj5dbv3abhc5lmnna9r2dt7qo98qp5k.apps.googleusercontent.com
