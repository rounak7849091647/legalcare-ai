# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist[0-9]*/
dist-ssr
*.local

# Backend deploy bundles
legalcare-backend-*.zip
legal-rights-docs.zip
legal-rights-docs/

# Local agent config
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tier 2 large indexes (hosted in S3, not git)
server/data/state-fulltext-index.json
server/data/state-fulltext.db
server/data/state-fulltext.db-*

# eval run output
server/eval/last-report.json
.env.local

# --- secrets (never commit) ---
.env
.env.*
!.env.example
server/.env
server/.env.*

# --- large generated indexes (exceed GitHub 100MB; rebuilt by scripts) ---
server/data/*.json
server/data/*.db
server/data/*.db-*

# --- bundled embedding model (downloaded at setup) ---
server/models/

# --- build output / archives ---
dist*/
*.zip
node_modules/

# npm is the toolchain here; stray bun lockfiles make Cloudflare
# pick bun and fail on --frozen-lockfile
bun.lock
bun.lockb

# public build-time config (no secrets) — must be committed for CI builds
!.env.production
